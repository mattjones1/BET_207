{
  "name": "bet-207",
  "private": true,
  "description": "EdgeBoard: a personal sports handicapping research platform (NFL, college football, NBA).",
  "workspaces": [
    "packages/core",
    "packages/pipeline",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
