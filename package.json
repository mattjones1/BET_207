    "pipeline": "npm run cli -w packages/pipeline --"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
