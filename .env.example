# ── Browser (apps/web). Safe to expose: the publishable key is protected by Row Level Security. ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Set to 1 to force the labeled demo-data mode (also used automatically when the two values above are empty).
VITE_DEMO=0

# ── Pipeline only (packages/pipeline, GitHub Actions secrets). NEVER prefix these with VITE_. ──
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ODDS_API_KEY=
CFBD_API_KEY=
BALLDONTLIE_API_KEY=
# Keep at least this many Odds API credits in reserve; odds jobs skip when a pull would go below it.
ODDS_API_RESERVE=60
